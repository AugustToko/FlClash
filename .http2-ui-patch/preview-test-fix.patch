+Future<void> _scrollCapturePageUntilVisible(
+  WidgetTester tester,
+  Finder target, {
+  bool reverse = false,
+  int maxScrolls = 16,
+}) async {
+  final scrollView = find.byType(CustomScrollView);
+  expect(scrollView, findsOneWidget);
+  for (var index = 0; index < maxScrolls && target.evaluate().isEmpty; index++) {
+    await tester.drag(
+      scrollView,
+      Offset(0, reverse ? 320 : -320),
+    );
+    await tester.pumpAndSettle();
+  }
+  expect(target, findsWidgets);
+  await tester.ensureVisible(target.first);
+  await tester.pumpAndSettle();
+}
+
+Future<void> _scrollDetailsUntilVisible(
+  WidgetTester tester,
+  Finder target, {
+  bool reverse = false,
+  int maxScrolls = 16,
+}) async {
+  final detailsList = find.byType(ListView).last;
+  for (var index = 0; index < maxScrolls && target.evaluate().isEmpty; index++) {
+    await tester.drag(
+      detailsList,
+      Offset(0, reverse ? 280 : -280),
+    );
+    await tester.pumpAndSettle();
+  }
+  expect(target, findsWidgets);
+  await tester.ensureVisible(target.first);
+  await tester.pumpAndSettle();
+}
