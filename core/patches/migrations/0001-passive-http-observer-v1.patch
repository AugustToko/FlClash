--- /dev/null
+++ b/tunnel/observation_test.go
@@ -0,0 +1,79 @@
+package tunnel
+
+import (
+	"bytes"
+	"io"
+	"net"
+	"testing"
+
+	N "github.com/metacubex/mihomo/common/net"
+	"github.com/metacubex/mihomo/component/observer"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+func TestInitialTCPObservationReadsEnoughWithoutConsuming(t *testing.T) {
+	payload := []byte("GET /health?token=private HTTP/1.1\r\nHost: API.Example.com:8080\r\nAuthorization: secret\r\n\r\nbody")
+	client, peer := net.Pipe()
+	conn := N.NewBufferedConn(client)
+	observer.Configure(true, "session-a")
+	t.Cleanup(func() {
+		observer.SetEnabled(false)
+		_ = conn.Close()
+		_ = peer.Close()
+	})
+
+	resultCh := make(chan *C.ProtocolObservation, 1)
+	go func() {
+		resultCh <- initialTCPObservation(conn, true, "session-a")
+	}()
+	writeDone := make(chan error, 1)
+	go func() {
+		_, err := peer.Write(payload)
+		writeDone <- err
+	}()
+
+	result := <-resultCh
+	if result == nil || result.HTTP == nil {
+		t.Fatalf("HTTP observation = %#v", result)
+	}
+	if result.SessionID != "session-a" {
+		t.Fatalf("session ID = %q", result.SessionID)
+	}
+	if result.HTTP.Method != "GET" || result.HTTP.Target != "/health" || result.HTTP.Host != "api.example.com" {
+		t.Fatalf("HTTP metadata = %#v", result.HTTP)
+	}
+
+	replayed := make([]byte, len(payload))
+	if _, err := io.ReadFull(conn, replayed); err != nil {
+		t.Fatalf("read buffered payload: %v", err)
+	}
+	if !bytes.Equal(replayed, payload) {
+		t.Fatal("initial observation changed relayed bytes")
+	}
+	if err := <-writeDone; err != nil {
+		t.Fatalf("write payload: %v", err)
+	}
+}
+
+func TestInitialTCPPeekRemainsBoundedWhenObservationIsDisabled(t *testing.T) {
+	client, peer := net.Pipe()
+	conn := N.NewBufferedConn(client)
+	t.Cleanup(func() {
+		_ = conn.Close()
+		_ = peer.Close()
+	})
+
+	resultCh := make(chan *C.ProtocolObservation, 1)
+	go func() {
+		resultCh <- initialTCPObservation(conn, false, "")
+	}()
+	if _, err := peer.Write([]byte{'X'}); err != nil {
+		t.Fatal(err)
+	}
+	if result := <-resultCh; result != nil {
+		t.Fatalf("disabled observation returned %#v", result)
+	}
+	if conn.Buffered() != 1 {
+		t.Fatalf("buffered = %d, want existing one-byte peek", conn.Buffered())
+	}
+}
