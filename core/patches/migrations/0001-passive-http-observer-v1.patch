+package observer
+
+import (
+	"bytes"
+	"encoding/binary"
+	"net"
+	"net/url"
+	"strconv"
+	"strings"
+	"sync/atomic"
+	"time"
+	"unicode/utf8"
+
+	"github.com/metacubex/sing/common/metadata"
+
+	N "github.com/metacubex/mihomo/common/net"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+const (
+	defaultObservationTimeout = 200 * time.Millisecond
+	maxObservationBytes       = 32 * 1024
+	maxHTTPHeaderNames        = 64
+	maxHTTPHeaderNameBytes    = 128
+	maxRequestTargetBytes     = 512
+	maxHostBytes              = 255
+	maxTLSListItems           = 16
+	tlsRecordHeaderLen        = 5
+	tlsMaxPlaintext           = 1 << 14
+)
+
+type configuration struct {
+	enabled   bool
+	sessionID string
+}
+
+var currentConfiguration atomic.Pointer[configuration]
+
+func init() {
+	currentConfiguration.Store(&configuration{})
+}
+
+// Configure controls the passive observer globally. The session ID is copied
+// into every observation so a delayed connection from an older capture session
+// cannot be attributed to a newer one.
+func Configure(value bool, sessionID string) {
+	if !value {
+		currentConfiguration.Store(&configuration{})
+		return
+	}
+	sessionID = strings.TrimSpace(sessionID)
+	if containsControl(sessionID) {
+		sessionID = ""
+	}
+	sessionID = boundedText(sessionID, 128)
+	currentConfiguration.Store(&configuration{enabled: true, sessionID: sessionID})
+}
+
+// SetEnabled is kept for callers that do not need capture-session correlation.
+func SetEnabled(value bool) {
+	Configure(value, "")
+}
+
+func Enabled() bool {
+	state := currentConfiguration.Load()
+	return state != nil && state.enabled
+}
+
+func SessionID() string {
+	state := currentConfiguration.Load()
+	if state == nil || !state.enabled {
+		return ""
+	}
+	return state.sessionID
+}
+
+// PrepareTCP reports whether this connection is eligible for passive
+// observation and snapshots the active capture session. It deliberately does
+// not read or grow the connection buffer: the eligibility check is allocation-
+// free and does not add serial connection latency.
+func PrepareTCP(conn *N.BufferedConn) (sessionID string, prepared bool) {
+	state := currentConfiguration.Load()
+	if state == nil || !state.enabled || conn == nil {
+		return "", false
+	}
+	return state.sessionID, true
+}
+
+// ObserveBufferedTCP parses only bytes that are already buffered by Mihomo's
+// normal sniff/read-ahead path. It never waits for more client data and never
+// consumes or rewrites the buffered bytes.
+func ObserveBufferedTCP(conn *N.BufferedConn, sessionID string) *C.ProtocolObservation {
+	if conn == nil {
+		return nil
+	}
+	available := conn.Buffered()
+	if available <= 0 {
+		return nil
+	}
+	if available > maxObservationBytes {
+		available = maxObservationBytes
+	}
+	data, err := conn.Peek(available)
+	if err != nil && len(data) == 0 {
+		return nil
+	}
+	return withSessionID(observeBuffered(data, maxObservationBytes), sessionID)
+}
+
+// ObserveTCP reads a bounded initial prefix for a connection that was accepted
+// by PrepareTCP. Production tunnel code overlaps this read with route/dial work.
+func ObserveTCP(conn *N.BufferedConn, sessionID string) *C.ProtocolObservation {
+	return withSessionID(
+		observeTCP(conn, defaultObservationTimeout, maxObservationBytes),
+		sessionID,
+	)
+}
+
+func withSessionID(observation *C.ProtocolObservation, sessionID string) *C.ProtocolObservation {
+	if observation != nil {
+		observation.SessionID = boundedText(sessionID, 128)
+	}
+	return observation
+}
+
+func observeBuffered(data []byte, limit int) *C.ProtocolObservation {
+	if limit <= 0 || len(data) == 0 {
+		return nil
+	}
+	if len(data) > limit {
+		data = data[:limit]
+	}
+	switch {
+	case data[0] == 0x16:
+		handshake, valid, needWire, wireTruncated := extractTLSHandshake(data, limit)
+		if !valid {
+			return nil
+		}
+		tls, recognized, complete, metadataTruncated := parseTLSClientHello(handshake)
+		if !recognized || tls == nil {
+			return nil
+		}
+		observedBytes := len(data)
+		if complete && needWire > 0 && needWire < observedBytes {
+			observedBytes = needWire
+		}
+		return &C.ProtocolObservation{
+			Kind:          "tls-client-hello",
+			ObservedBytes: observedBytes,
+			Truncated:     !complete || wireTruncated || metadataTruncated,
+			TLS:           tls,
+		}
+	case isHTTPMethodPrefix(data):
+		http, valid, complete, need := parseHTTPPrefix(data)
+		if !valid || http == nil {
+			return nil
+		}
+		observedBytes := len(data)
+		if complete && need > 0 && need < observedBytes {
+			observedBytes = need
+		}
+		return &C.ProtocolObservation{
+			Kind:          "http1",
+			ObservedBytes: observedBytes,
+			Truncated:     !complete || httpMetadataTruncated(http),
+			HTTP:          http,
+		}
+	default:
+		return nil
+	}
+}
+
+func observeTCP(conn *N.BufferedConn, timeout time.Duration, limit int) *C.ProtocolObservation {
+	if conn == nil || limit <= 0 {
+		return nil
+	}
+	deadline := time.Now().Add(timeout)
+	data, _ := peekAtLeast(conn, 1, deadline, limit)
+	if len(data) == 0 {
+		return nil
+	}
+
+	switch {
+	case data[0] == 0x16:
+		return observeTLS(conn, deadline, limit)
+	case isHTTPMethodPrefix(data):
+		return observeHTTP(conn, deadline, limit)
+	default:
+		return nil
+	}
+}
+
+func peekAtLeast(conn *N.BufferedConn, want int, deadline time.Time, limit int) ([]byte, error) {
+	if want < 1 {
+		want = 1
+	}
+	if want > limit {
+		want = limit
+	}
+	conn.Grow(want)
+	_ = conn.SetReadDeadline(deadline)
+	_, err := conn.Peek(want)
+	_ = conn.SetReadDeadline(time.Time{})
+
+	available := conn.Buffered()
+	if available > limit {
+		available = limit
+	}
+	if available == 0 {
+		return nil, err
+	}
+	data, peekErr := conn.Peek(available)
+	if err == nil {
+		err = peekErr
+	}
+	return data, err
+}
+
+var httpMethods = [...]string{
+	"GET", "POST", "HEAD", "PUT", "DELETE", "OPTIONS", "CONNECT", "PATCH", "TRACE",
+}
+
+func isHTTPMethodPrefix(data []byte) bool {
+	for _, method := range httpMethods {
+		if len(data) <= len(method) && bytes.Equal(data, []byte(method[:len(data)])) {
+			return true
+		}
+		if len(data) > len(method) && bytes.Equal(data[:len(method)], []byte(method)) && data[len(method)] == ' ' {
+			return true
+		}
+	}
+	return false
+}
+
+func isHTTPMethod(method string) bool {
+	for _, candidate := range httpMethods {
+		if method == candidate {
+			return true
+		}
+	}
+	return false
+}
+
+func observeHTTP(conn *N.BufferedConn, deadline time.Time, limit int) *C.ProtocolObservation {
+	want := 1
+	for {
+		data, err := peekAtLeast(conn, want, deadline, limit)
+		http, valid, complete, need := parseHTTPPrefix(data)
+		if !valid {
+			return nil
+		}
+		if http != nil && complete {
+			return &C.ProtocolObservation{
+				Kind:          "http1",
+				ObservedBytes: need,
+				Truncated:     httpMetadataTruncated(http),
+				HTTP:          http,
+			}
+		}
+		if len(data) >= limit || err != nil || time.Now().After(deadline) {
+			if http == nil {
+				return nil
+			}
+			return &C.ProtocolObservation{
+				Kind:          "http1",
+				ObservedBytes: len(data),
+				Truncated:     true,
+				HTTP:          http,
+			}
+		}
+		if need <= len(data) {
+			need = len(data) + 1
+		}
+		if need > limit {
+			if http == nil {
+				return nil
+			}
+			return &C.ProtocolObservation{
+				Kind:          "http1",
+				ObservedBytes: len(data),
+				Truncated:     true,
+				HTTP:          http,
+			}
+		}
+		want = need
+	}
+}
+
+func parseHTTPPrefix(data []byte) (*C.HTTPObservation, bool, bool, int) {
+	space := bytes.IndexByte(data, ' ')
+	if space < 0 {
+		return nil, isHTTPMethodPrefix(data), false, len(data) + 1
+	}
+	method := string(data[:space])
+	if !isHTTPMethod(method) {
+		return nil, false, false, 0
+	}
+
+	lineEnd := bytes.Index(data, []byte("\r\n"))
+	if lineEnd < 0 {
+		return nil, true, false, len(data) + 1
+	}
+	parts := bytes.Fields(data[:lineEnd])
+	if len(parts) != 3 {
+		return nil, false, false, 0
+	}
+	method = string(parts[0])
+	if !isHTTPMethod(method) {
+		return nil, false, false, 0
+	}
+	version := string(parts[2])
+	if version != "HTTP/1.0" && version != "HTTP/1.1" {
+		return nil, false, false, 0
+	}
+	target, absoluteHost, targetTruncated, hostTruncated, ok := sanitizeRequestTarget(method, string(parts[1]))
+	if !ok {
+		return nil, false, false, 0
+	}
+
+	observation := &C.HTTPObservation{
+		Method:          method,
+		Target:          target,
+		Version:         version,
+		Host:            absoluteHost,
+		TargetTruncated: targetTruncated,
+		HostTruncated:   hostTruncated,
+	}
+	seenNames := make(map[string]struct{}, maxHTTPHeaderNames)
+	offset := lineEnd + 2
+	for {
+		relativeEnd := bytes.Index(data[offset:], []byte("\r\n"))
+		if relativeEnd < 0 {
+			return observation, true, false, len(data) + 1
+		}
+		lineEnd = offset + relativeEnd
+		line := data[offset:lineEnd]
+		offset = lineEnd + 2
+		if len(line) == 0 {
+			observation.HeadersComplete = true
+			return observation, true, true, offset
+		}
+		if line[0] == ' ' || line[0] == '\t' {
+			// Obsolete line folding is ignored. Retaining it would require
+			// retaining a header value, which this observer deliberately avoids.
+			continue
+		}
+		colon := bytes.IndexByte(line, ':')
+		if colon <= 0 {
+			return nil, false, false, 0
+		}
+		nameBytes := line[:colon]
+		if !validHeaderName(nameBytes) {
+			return nil, false, false, 0
+		}
+		name, nameTruncated := boundedTextWithTruncation(
+			strings.ToLower(string(nameBytes)),
+			maxHTTPHeaderNameBytes,
+		)
+		observation.HeaderNamesTruncated = observation.HeaderNamesTruncated || nameTruncated
+		if _, exists := seenNames[name]; !exists {
+			seenNames[name] = struct{}{}
+			if len(observation.HeaderNames) < maxHTTPHeaderNames {
+				observation.HeaderNames = append(observation.HeaderNames, name)
+			} else {
+				observation.HeaderNamesTruncated = true
+			}
+		}
+		if name == "host" && observation.Host == "" {
+			host, truncated := sanitizeHTTPHost(string(bytes.TrimSpace(line[colon+1:])))
+			observation.Host = host
+			observation.HostTruncated = truncated
+		}
+	}
+}
+
+func validHeaderName(value []byte) bool {
+	if len(value) == 0 {
+		return false
+	}
+	for _, b := range value {
+		switch {
+		case b >= 'a' && b <= 'z', b >= 'A' && b <= 'Z', b >= '0' && b <= '9':
+		case strings.ContainsRune("!#$%&'*+-.^_`|~", rune(b)):
+		default:
+			return false
+		}
+	}
+	return true
+}
+
+func httpMetadataTruncated(observation *C.HTTPObservation) bool {
+	return observation != nil && (observation.TargetTruncated || observation.HostTruncated || observation.HeaderNamesTruncated)
+}
+
+func sanitizeRequestTarget(method, raw string) (target string, host string, targetTruncated bool, hostTruncated bool, ok bool) {
+	if raw == "" || containsControl(raw) {
+		return "", "", false, false, false
+	}
+	if method == "CONNECT" {
+		return sanitizeConnectAuthority(raw)
+	}
+	if raw == "*" {
+		return raw, "", false, false, true
+	}
+
+	if parsed, err := url.ParseRequestURI(raw); err == nil && parsed.IsAbs() {
+		host, hostTruncated = sanitizeHTTPHost(parsed.Host)
+		if host == "" {
+			return "", "", false, false, false
+		}
+		target = parsed.EscapedPath()
+		if target == "" {
+			target = "/"
+		}
+		target, targetTruncated = boundedTextWithTruncation(target, maxRequestTargetBytes)
+		return target, host, targetTruncated, hostTruncated, true
+	}
+
+	if index := strings.IndexAny(raw, "?#"); index >= 0 {
+		raw = raw[:index]
+	}
+	if raw == "" {
+		raw = "/"
+	}
+	if raw[0] != '/' {
+		return "", "", false, false, false
+	}
+	target, targetTruncated = boundedTextWithTruncation(raw, maxRequestTargetBytes)
+	return target, "", targetTruncated, false, true
+}
+
+func sanitizeConnectAuthority(raw string) (target string, host string, targetTruncated bool, hostTruncated bool, ok bool) {
+	raw = strings.TrimSpace(raw)
+	if raw == "" || containsControl(raw) || strings.ContainsAny(raw, " /?#\t\r\n") {
+		return "", "", false, false, false
+	}
+	// CONNECT userinfo is invalid authority-form. If a malformed client sends
+	// it anyway, drop the sensitive prefix rather than retaining credentials.
+	if at := strings.LastIndexByte(raw, '@'); at >= 0 {
+		raw = raw[at+1:]
+	}
+	rawHost, rawPort, err := net.SplitHostPort(raw)
+	if err != nil {
+		return "", "", false, false, false
+	}
+	port, err := strconv.Atoi(rawPort)
+	if err != nil || port < 1 || port > 65535 {
+		return "", "", false, false, false
+	}
+	host, hostTruncated = sanitizeHTTPHost(rawHost)
+	if host == "" {
+		return "", "", false, false, false
+	}
+	authority := net.JoinHostPort(host, strconv.Itoa(port))
+	target, targetTruncated = boundedTextWithTruncation(authority, maxRequestTargetBytes)
+	return target, host, targetTruncated, hostTruncated, true
+}
+
+func sanitizeHTTPHost(raw string) (string, bool) {
+	raw = strings.TrimSpace(raw)
+	if raw == "" || containsControl(raw) || strings.ContainsAny(raw, " /?#\t\r\n") {
+		return "", false
+	}
+	if at := strings.LastIndexByte(raw, '@'); at >= 0 {
+		raw = raw[at+1:]
+	}
+
+	host := raw
+	switch {
+	case strings.HasPrefix(raw, "["):
+		closing := strings.IndexByte(raw, ']')
+		if closing <= 1 {
+			return "", false
+		}
+		host = raw[1:closing]
+		if net.ParseIP(host) == nil {
+			return "", false
+		}
+		remainder := raw[closing+1:]
+		if remainder != "" {
+			if remainder[0] != ':' || !validHTTPPort(remainder[1:]) {
+				return "", false
+			}
+		}
+	case net.ParseIP(raw) != nil:
+		// A bare IP literal has no authority port to strip.
+	case strings.Count(raw, ":") == 1:
+		var port string
+		var err error
+		host, port, err = net.SplitHostPort(raw)
+		if err != nil || !validHTTPPort(port) {
+			return "", false
+		}
+	case strings.ContainsRune(raw, ':'):
+		// Non-bracketed IPv6 authorities are ambiguous and invalid in HTTP Host.
+		return "", false
+	}
+
+	host = strings.TrimSuffix(strings.TrimSpace(host), ".")
+	if host == "" || !validHTTPHostName(host) {
+		return "", false
+	}
+	value, truncated := boundedTextWithTruncation(host, maxHostBytes)
+	return strings.ToLower(value), truncated
+}
+
+func validHTTPHostName(value string) bool {
+	if net.ParseIP(value) != nil {
+		return true
+	}
+	if strings.HasPrefix(value, ".") || strings.HasSuffix(value, ".") || strings.Contains(value, "..") {
+		return false
+	}
+	for _, b := range []byte(value) {
+		switch {
+		case b >= 'a' && b <= 'z', b >= 'A' && b <= 'Z', b >= '0' && b <= '9', b == '-', b == '_', b == '.':
+		default:
+			return false
+		}
+	}
+	return true
+}
+
+func validHTTPPort(raw string) bool {
+	port, err := strconv.Atoi(raw)
+	return err == nil && port >= 1 && port <= 65535
+}
+
+func sanitizeServerName(raw string) (string, bool) {
+	name := strings.ToLower(strings.TrimSpace(raw))
+	if name == "" || containsControl(name) || len(name) > maxHostBytes || strings.HasSuffix(name, ".") || !metadata.IsDomainName(name) {
+		return "", false
+	}
+	return name, true
+}
+
+func boundedText(value string, limit int) string {
+	bounded, _ := boundedTextWithTruncation(value, limit)
+	return bounded
+}
+
+func boundedTextWithTruncation(value string, limit int) (string, bool) {
+	value = strings.ToValidUTF8(value, "�")
+	if len(value) <= limit {
+		return value, false
+	}
+	value = value[:limit]
+	for len(value) > 0 && !utf8.ValidString(value) {
+		value = value[:len(value)-1]
+	}
+	return value, true
+}
+
+func containsControl(value string) bool {
+	for i := 0; i < len(value); i++ {
+		if value[i] < 0x20 || value[i] == 0x7f {
+			return true
+		}
+	}
+	return false
+}
+
+func observeTLS(conn *N.BufferedConn, deadline time.Time, limit int) *C.ProtocolObservation {
+	want := tlsRecordHeaderLen
+	for {
+		wire, err := peekAtLeast(conn, want, deadline, limit)
+		handshake, valid, needWire, wireTruncated := extractTLSHandshake(wire, limit)
+		if !valid {
+			return nil
+		}
+		tls, recognized, complete, metadataTruncated := parseTLSClientHello(handshake)
+		if complete {
+			return &C.ProtocolObservation{
+				Kind:          "tls-client-hello",
+				ObservedBytes: minInt(needWire, len(wire)),
+				Truncated:     wireTruncated || metadataTruncated,
+				TLS:           tls,
+			}
+		}
+		if len(wire) >= limit || wireTruncated || err != nil || time.Now().After(deadline) {
+			if !recognized || tls == nil {
+				return nil
+			}
+			return &C.ProtocolObservation{
+				Kind:          "tls-client-hello",
+				ObservedBytes: len(wire),
+				Truncated:     true,
+				TLS:           tls,
+			}
+		}
+		if needWire <= len(wire) {
+			needWire = len(wire) + 1
+		}
+		if needWire > limit {
+			if !recognized || tls == nil {
+				return nil
+			}
+			return &C.ProtocolObservation{
+				Kind:          "tls-client-hello",
+				ObservedBytes: len(wire),
+				Truncated:     true,
+				TLS:           tls,
+			}
+		}
+		want = needWire
+	}
+}
+
+func extractTLSHandshake(wire []byte, limit int) (handshake []byte, valid bool, needWire int, truncated bool) {
+	offset := 0
+	for {
+		if len(wire)-offset < tlsRecordHeaderLen {
+			return handshake, true, offset + tlsRecordHeaderLen, false
+		}
+		header := wire[offset : offset+tlsRecordHeaderLen]
+		if header[0] != 0x16 || header[1] != 0x03 {
+			return nil, false, 0, false
+		}
+		recordLen := int(binary.BigEndian.Uint16(header[3:5]))
+		if recordLen <= 0 || recordLen > tlsMaxPlaintext {
+			return nil, false, 0, false
+		}
+		payloadStart := offset + tlsRecordHeaderLen
+		recordEnd := payloadStart + recordLen
+		availableEnd := recordEnd
+		if availableEnd > len(wire) {
+			availableEnd = len(wire)
+		}
+		if availableEnd > payloadStart {
+			handshake = append(handshake, wire[payloadStart:availableEnd]...)
+		}
+		if len(handshake) >= 4 && handshake[0] == 0x01 {
+			helloLen := 4 + uint24(handshake[1:4])
+			if helloLen < 4 {
+				return nil, false, 0, false
+			}
+			if len(handshake) >= helloLen {
+				return handshake[:helloLen], true, recordEnd, false
+			}
+		}
+		if recordEnd > limit {
+			return handshake, true, limit, true
+		}
+		if recordEnd > len(wire) {
+			return handshake, true, recordEnd, false
+		}
+		offset = recordEnd
+		if offset >= limit {
+			return handshake, true, limit, true
+		}
+	}
+}
+
+func parseTLSClientHello(data []byte) (observation *C.TLSClientHelloObservation, recognized bool, complete bool, metadataTruncated bool) {
+	if len(data) == 0 || data[0] != 0x01 {
+		return nil, false, false, false
+	}
+	observation = &C.TLSClientHelloObservation{}
+	if len(data) < 4 {
+		return observation, true, false, false
+	}
+	total := 4 + uint24(data[1:4])
+	if total < 4+2+32+1+2+1 {
+		return nil, false, false, false
+	}
+	available := data
+	if len(available) > total {
+		available = available[:total]
+	}
+	cursor := 4
+	need := func(count int) bool { return cursor+count <= len(available) }
+	if !need(2) {
+		return observation, true, false, false
+	}
+	observation.LegacyVersion = tlsVersion(binary.BigEndian.Uint16(available[cursor : cursor+2]))
+	cursor += 2
+	if !need(32) {
+		return observation, true, false, false
+	}
+	cursor += 32
+	if !need(1) {
+		return observation, true, false, false
+	}
+	sessionLen := int(available[cursor])
+	cursor++
+	if sessionLen > 32 {
+		return nil, false, false, false
+	}
+	if !need(sessionLen) {
+		return observation, true, false, false
+	}
+	cursor += sessionLen
+	if !need(2) {
+		return observation, true, false, false
+	}
+	cipherLen := int(binary.BigEndian.Uint16(available[cursor : cursor+2]))
+	cursor += 2
+	if cipherLen == 0 || cipherLen%2 != 0 {
+		return nil, false, false, false
+	}
+	if !need(cipherLen) {
+		return observation, true, false, false
+	}
+	cursor += cipherLen
+	if !need(1) {
+		return observation, true, false, false
+	}
+	compressionLen := int(available[cursor])
+	cursor++
+	if compressionLen == 0 {
+		return nil, false, false, false
+	}
+	if !need(compressionLen) {
+		return observation, true, false, false
+	}
+	cursor += compressionLen
+	if cursor == total {
+		observation.ClientHelloComplete = len(data) >= total
+		return observation, true, observation.ClientHelloComplete, false
+	}
+	if !need(2) {
+		return observation, true, false, false
+	}
+	extensionsLen := int(binary.BigEndian.Uint16(available[cursor : cursor+2]))
+	cursor += 2
+	extensionsEnd := cursor + extensionsLen
+	if extensionsEnd != total {
+		return nil, false, false, false
+	}
+	parseEnd := extensionsEnd
+	if parseEnd > len(available) {
+		parseEnd = len(available)
+	}
+	for cursor < parseEnd {
+		if cursor+4 > parseEnd {
+			return observation, true, false, metadataTruncated
+		}
+		extensionType := binary.BigEndian.Uint16(available[cursor : cursor+2])
+		extensionLen := int(binary.BigEndian.Uint16(available[cursor+2 : cursor+4]))
+		cursor += 4
+		extensionEnd := cursor + extensionLen
+		if extensionEnd > extensionsEnd {
+			return nil, false, false, false
+		}
+		if extensionEnd > parseEnd {
+			return observation, true, false, metadataTruncated
+		}
+		payload := available[cursor:extensionEnd]
+		var ok bool
+		switch extensionType {
+		case 0x0000:
+			observation.ServerName, ok = parseServerName(payload)
+			if !ok {
+				return nil, false, false, false
+			}
+		case 0x0010:
+			observation.ALPN, observation.ALPNTruncated, ok = parseALPN(payload)
+			if !ok {
+				return nil, false, false, false
+			}
+			metadataTruncated = metadataTruncated || observation.ALPNTruncated
+		case 0x002b:
+			observation.SupportedVersions, observation.SupportedVersionsTruncated, ok = parseSupportedVersions(payload)
+			if !ok {
+				return nil, false, false, false
+			}
+			metadataTruncated = metadataTruncated || observation.SupportedVersionsTruncated
+		case 0xfe0d, 0xffce:
+			observation.EncryptedClientHello = true
+		}
+		cursor = extensionEnd
+	}
+	observation.ClientHelloComplete = len(data) >= total && cursor == extensionsEnd
+	return observation, true, observation.ClientHelloComplete, metadataTruncated
+}
+
+func parseServerName(data []byte) (string, bool) {
+	if len(data) < 2 {
+		return "", false
+	}
+	listLen := int(binary.BigEndian.Uint16(data[:2]))
+	if listLen != len(data)-2 {
+		return "", false
+	}
+	cursor := 2
+	for cursor < len(data) {
+		if cursor+3 > len(data) {
+			return "", false
+		}
+		nameType := data[cursor]
+		nameLen := int(binary.BigEndian.Uint16(data[cursor+1 : cursor+3]))
+		cursor += 3
+		if cursor+nameLen > len(data) {
+			return "", false
+		}
+		if nameType == 0 {
+			name, valid := sanitizeServerName(string(data[cursor : cursor+nameLen]))
+			if !valid {
+				return "", false
+			}
+			return name, true
+		}
+		cursor += nameLen
+	}
+	return "", true
+}
+
+func parseALPN(data []byte) ([]string, bool, bool) {
+	if len(data) < 2 {
+		return nil, false, false
+	}
+	listLen := int(binary.BigEndian.Uint16(data[:2]))
+	if listLen != len(data)-2 {
+		return nil, false, false
+	}
+	values := make([]string, 0, 4)
+	truncated := false
+	cursor := 2
+	for cursor < len(data) {
+		length := int(data[cursor])
+		cursor++
+		if length == 0 || cursor+length > len(data) {
+			return nil, false, false
+		}
+		value := string(data[cursor : cursor+length])
+		if containsControl(value) {
+			return nil, false, false
+		}
+		if len(values) < maxTLSListItems {
+			values = append(values, boundedText(value, 255))
+		} else {
+			truncated = true
+		}
+		cursor += length
+	}
+	return values, truncated, true
+}
+
+func parseSupportedVersions(data []byte) ([]string, bool, bool) {
+	if len(data) < 1 {
+		return nil, false, false
+	}
+	listLen := int(data[0])
+	if listLen != len(data)-1 || listLen%2 != 0 {
+		return nil, false, false
+	}
+	values := make([]string, 0, listLen/2)
+	truncated := false
+	for cursor := 1; cursor < len(data); cursor += 2 {
+		value := tlsVersion(binary.BigEndian.Uint16(data[cursor : cursor+2]))
+		if len(values) < maxTLSListItems {
+			values = append(values, value)
+		} else {
+			truncated = true
+		}
+	}
+	return values, truncated, true
+}
+
+func tlsVersion(value uint16) string {
+	switch value {
+	case 0x0301:
+		return "TLS 1.0"
+	case 0x0302:
+		return "TLS 1.1"
+	case 0x0303:
+		return "TLS 1.2"
+	case 0x0304:
+		return "TLS 1.3"
+	default:
+		return "0x" + strings.ToUpper(hex4(value))
+	}
+}
+
+func hex4(value uint16) string {
+	const digits = "0123456789abcdef"
+	return string([]byte{
+		digits[(value>>12)&0xf],
+		digits[(value>>8)&0xf],
+		digits[(value>>4)&0xf],
+		digits[value&0xf],
+	})
+}
+
+func uint24(data []byte) int {
+	return int(data[0])<<16 | int(data[1])<<8 | int(data[2])
+}
+
+func minInt(a, b int) int {
+	if a < b {
+		return a
+	}
+	return b
+}
