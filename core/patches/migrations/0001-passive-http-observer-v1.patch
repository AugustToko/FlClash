+		writeDone <- err
+	}()
+	_ = conn.SetReadDeadline(time.Now().Add(time.Second))
+	if _, err := conn.Peek(len(payload)); err != nil {
+		t.Fatalf("buffer payload: %v", err)
+	}
+	_ = conn.SetReadDeadline(time.Time{})
