new file mode 100644
index 0000000000000000000000000000000000000000..655e3f5fe874090292f009caf07a984b2911b047
--- /dev/null
+++ b/constant/observation.go
@@ -0,0 +1,43 @@
+package constant
+
+// ProtocolObservation is a bounded, privacy-preserving description of the
+// client bytes Mihomo already had to relay. It intentionally contains no raw
+// packet bytes, HTTP header values (except Host), query strings, bodies, or
+// decrypted TLS application data.
+type ProtocolObservation struct {
+	SessionID     string                     `json:"sessionId,omitempty"`
+	Kind          string                     `json:"kind"`
+	ObservedBytes int                        `json:"observedBytes"`
+	Truncated     bool                       `json:"truncated,omitempty"`
+	HTTP          *HTTPObservation           `json:"http,omitempty"`
+	TLS           *TLSClientHelloObservation `json:"tls,omitempty"`
+}
+
+// HTTPObservation describes one client HTTP/1.x request prefix. Target is
+// sanitized before storage: query and fragment components are removed and the
+// retained value is bounded.
+type HTTPObservation struct {
+	Method               string   `json:"method"`
+	Target               string   `json:"target"`
+	Version              string   `json:"version"`
+	Host                 string   `json:"host,omitempty"`
+	HeaderNames          []string `json:"headerNames,omitempty"`
+	HeadersComplete      bool     `json:"headersComplete"`
+	TargetTruncated      bool     `json:"targetTruncated,omitempty"`
+	HostTruncated        bool     `json:"hostTruncated,omitempty"`
+	HeaderNamesTruncated bool     `json:"headerNamesTruncated,omitempty"`
+}
+
+// TLSClientHelloObservation contains only metadata that is visible in a
+// plaintext TLS ClientHello. It never contains certificates, secrets, or
+// application data.
+type TLSClientHelloObservation struct {
+	ServerName                 string   `json:"serverName,omitempty"`
+	ALPN                       []string `json:"alpn,omitempty"`
+	LegacyVersion              string   `json:"legacyVersion,omitempty"`
+	SupportedVersions          []string `json:"supportedVersions,omitempty"`
+	EncryptedClientHello       bool     `json:"encryptedClientHello,omitempty"`
+	ClientHelloComplete        bool     `json:"clientHelloComplete"`
+	ALPNTruncated              bool     `json:"alpnTruncated,omitempty"`
+	SupportedVersionsTruncated bool     `json:"supportedVersionsTruncated,omitempty"`
+}
