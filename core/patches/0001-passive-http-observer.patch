+	conn := N.NewBufferedConn(client)
+	t.Cleanup(func() {
+		SetEnabled(false)
+		_ = conn.Close()
+		_ = peer.Close()
+	})
+
+	SetEnabled(false)
+	if allocations := testing.AllocsPerRun(1000, func() {
+		_, _ = PrepareTCP(conn)
+	}); allocations != 0 {
+		t.Fatalf("disabled PrepareTCP allocated %.2f objects", allocations)
+	}
+
+	Configure(true, "session-a")
+	if allocations := testing.AllocsPerRun(1000, func() {
+		_, _ = PrepareTCP(conn)
+	}); allocations != 0 {
+		t.Fatalf("enabled PrepareTCP allocated %.2f objects", allocations)
+	}
+}
+
+func TestPrepareTCPDoesNotReadOrMarkPeeked(t *testing.T) {
+	client, peer := net.Pipe()
+	conn := N.NewBufferedConn(client)
+	SetEnabled(true)
+	t.Cleanup(func() {
+		SetEnabled(false)
+		_ = conn.Close()
+		_ = peer.Close()
+	})
+
+	if _, prepared := PrepareTCP(conn); !prepared {
+		t.Fatal("PrepareTCP returned false while enabled")
+	}
+	if conn.Peeked() || conn.Buffered() != 0 {
+		t.Fatalf("PrepareTCP changed reader state: peeked=%v buffered=%d", conn.Peeked(), conn.Buffered())
+	}
+}
+
+func TestPreparedSessionSurvivesAConfigurationChange(t *testing.T) {
+	Configure(true, "session-a")
+	client, peer := net.Pipe()
+	conn := N.NewBufferedConn(client)
+	t.Cleanup(func() {
+		SetEnabled(false)
+		_ = conn.Close()
+		_ = peer.Close()
+	})
+
+	sessionID, prepared := PrepareTCP(conn)
+	if !prepared || sessionID != "session-a" {
+		t.Fatalf("prepared = %v, session = %q", prepared, sessionID)
+	}
+	Configure(true, "session-b")
+
+	payload := []byte("GET / HTTP/1.1\r\nHost: example.com\r\n\r\n")
+	writeDone := make(chan error, 1)
+	go func() {
+		_, err := peer.Write(payload)
+		writeDone <- err
+	}()
+	result := ObserveTCP(conn, sessionID)
+	if result == nil || result.SessionID != "session-a" {
+		t.Fatalf("observation = %#v", result)
+	}
+	if err := <-writeDone; err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestConfigureBoundsTheSessionIdentifier(t *testing.T) {
+	Configure(true, strings.Repeat("s", 256))
+	t.Cleanup(func() { SetEnabled(false) })
+	if got := SessionID(); len(got) != 128 {
+		t.Fatalf("session ID length = %d", len(got))
+	}
+	Configure(true, "bad\nsession")
+	if got := SessionID(); got != "" {
+		t.Fatalf("control-bearing session ID = %q", got)
+	}
+}
+
+func TestObserveHTTPAbsoluteURIKeepsNoUserInfoOrQuery(t *testing.T) {
+	payload := []byte("GET http://user:private-password@example.com/private/path?token=secret HTTP/1.1\r\n" +
+		"Host: ignored.example\r\n\r\n")
+	_, result := observePayload(t, payload, time.Second, maxObservationBytes)
+	if result == nil || result.HTTP == nil {
+		t.Fatalf("absolute-form observation = %#v", result)
+	}
+	if result.HTTP.Host != "example.com" || result.HTTP.Target != "/private/path" {
+		t.Fatalf("sanitized absolute-form request = %#v", result.HTTP)
+	}
+	encoded, err := json.Marshal(result)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, secret := range []string{"user", "private-password", "token=secret"} {
+		if bytes.Contains(encoded, []byte(secret)) {
+			t.Fatalf("absolute-form observation retained %q: %s", secret, encoded)
+		}
+	}
+}
