+	response.ObservedAfterMilliseconds = time.Since(tt.Start).Milliseconds()
+	if response.ObservedAfterMilliseconds < 0 {
+		response.ObservedAfterMilliseconds = 0
+	}
+	tt.observationMu.Lock()
+	current = tt.TrackerInfo.Observation
+	if current == nil || !observer.ActiveSession(current.SessionID) {
+		tt.responseDone.Store(true)
+		tt.observationMu.Unlock()
+		tt.responseMu.Unlock()
+		return
+	}
+	updated := *current
+	updated.HTTPResponse = response
+	tt.TrackerInfo.Observation = &updated
