+	conn, result := observePayload(t, payload, time.Second, maxObservationBytes)
+	if result == nil || result.HTTP == nil {
+		t.Fatalf("HTTP observation = %#v", result)
+	}
+	if result.Kind != "http1" || result.HTTP.Method != "GET" || result.HTTP.Version != "HTTP/1.1" {
+		t.Fatalf("unexpected HTTP identity: %#v", result.HTTP)
+	}
+	if result.HTTP.Target != "/private/orders/42" {
+		t.Fatalf("sanitized target = %q", result.HTTP.Target)
+	}
+	if result.HTTP.Host != "api.example.com" {
+		t.Fatalf("host = %q", result.HTTP.Host)
+	}
+	wantNames := []string{"host", "authorization", "x-trace"}
+	if strings.Join(result.HTTP.HeaderNames, ",") != strings.Join(wantNames, ",") {
+		t.Fatalf("header names = %#v, want %#v", result.HTTP.HeaderNames, wantNames)
+	}
+	if !result.HTTP.HeadersComplete || result.Truncated {
+		t.Fatalf("completion = %#v", result)
+	}
+
+	encoded, err := json.Marshal(result)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, secret := range []string{"token=secret", "super-secret", "abc123", "body-must-not-be-stored"} {
+		if bytes.Contains(encoded, []byte(secret)) {
+			t.Fatalf("serialized observation retained %q: %s", secret, encoded)
