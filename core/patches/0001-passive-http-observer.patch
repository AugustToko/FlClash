+func TestTCPTrackerObservationMarshalIsRaceSafe(t *testing.T) {
+	tracker, server, notifications := newResponseTracker(
+		t,
+		"capture-session",
+		&C.HTTPObservation{
+			Method:          "GET",
+			Target:          "/",
+			Version:         "HTTP/1.1",
+			HeadersComplete: true,
+		},
+	)
+	<-notifications
+
+	stopMarshal := make(chan struct{})
+	marshalDone := make(chan error, 1)
+	go func() {
+		for {
+			select {
+			case <-stopMarshal:
+				marshalDone <- nil
+				return
+			default:
+				if _, err := json.Marshal(tracker); err != nil {
+					marshalDone <- err
+					return
+				}
+			}
+		}
+	}()
+
+	payload := []byte("HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n")
+	go func() {
+		_, _ = server.Write(payload)
+		_ = server.Close()
+	}()
+	reader, _ := tracker.UnwrapReader()
+	_, err := io.ReadAll(reader)
+	close(stopMarshal)
+	if marshalErr := <-marshalDone; marshalErr != nil {
+		t.Fatal(marshalErr)
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-notifications:
+	case <-time.After(time.Second):
+		t.Fatal("response update was not published")
+	}
+}
