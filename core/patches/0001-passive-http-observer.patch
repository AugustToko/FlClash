+func testClientHello(t testing.TB) []byte {
+	t.Helper()
+	extension := func(kind uint16, payload []byte) []byte {
+		value := make([]byte, 4+len(payload))
+		binary.BigEndian.PutUint16(value[0:2], kind)
+		binary.BigEndian.PutUint16(value[2:4], uint16(len(payload)))
+		copy(value[4:], payload)
+		return value
+	}
+
+	host := []byte("api.example.com")
+	serverName := make([]byte, 2+1+2+len(host))
+	binary.BigEndian.PutUint16(serverName[0:2], uint16(1+2+len(host)))
+	serverName[2] = 0
+	binary.BigEndian.PutUint16(serverName[3:5], uint16(len(host)))
+	copy(serverName[5:], host)
+
+	alpnValues := append([]byte{2}, []byte("h2")...)
+	alpnValues = append(alpnValues, byte(len("http/1.1")))
+	alpnValues = append(alpnValues, []byte("http/1.1")...)
+	alpn := make([]byte, 2+len(alpnValues))
+	binary.BigEndian.PutUint16(alpn[0:2], uint16(len(alpnValues)))
+	copy(alpn[2:], alpnValues)
+
+	versions := []byte{4, 0x03, 0x04, 0x03, 0x03}
+	extensions := append([]byte{}, extension(0x0000, serverName)...)
+	extensions = append(extensions, extension(0x0010, alpn)...)
+	extensions = append(extensions, extension(0x002b, versions)...)
+	extensions = append(extensions, extension(0xfe0d, []byte{0x00})...)
+
+	body := []byte{0x03, 0x03}
+	body = append(body, bytes.Repeat([]byte{0x42}, 32)...)
+	body = append(body, 0)
+	body = append(body, 0, 2, 0x13, 0x01)
+	body = append(body, 1, 0)
+	extensionLength := make([]byte, 2)
+	binary.BigEndian.PutUint16(extensionLength, uint16(len(extensions)))
+	body = append(body, extensionLength...)
+	body = append(body, extensions...)
+
+	handshake := []byte{0x01, byte(len(body) >> 16), byte(len(body) >> 8), byte(len(body))}
+	handshake = append(handshake, body...)
+	record := []byte{0x16, 0x03, 0x01, byte(len(handshake) >> 8), byte(len(handshake))}
+	return append(record, handshake...)
+}
