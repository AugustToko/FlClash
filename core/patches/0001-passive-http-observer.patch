index 00000000..58fe0425
--- /dev/null
+++ b/tunnel/statistic/http_response_test.go
@@ -0,0 +1,491 @@
+package statistic
+
+import (
+	"bytes"
+	"encoding/json"
+	"io"
+	"net"
+	"testing"
+	"time"
+
+	SBufio "github.com/metacubex/sing/common/bufio"
+
+	N "github.com/metacubex/mihomo/common/net"
+	"github.com/metacubex/mihomo/component/observer"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+type responseTestConn struct {
+	N.ExtendedConn
+}
+
+func (c *responseTestConn) Chains() C.Chain {
+	return C.Chain{"DIRECT"}
+}
+
+func (c *responseTestConn) ProviderChains() C.Chain {
+	return nil
+}
+
+func (c *responseTestConn) AppendToChains(C.ProxyAdapter) {}
+
+func (c *responseTestConn) RemoteDestination() string {
+	return ""
+}
+
+func newResponseTracker(
+	t *testing.T,
+	sessionID string,
+	request *C.HTTPObservation,
+) (*tcpTracker, net.Conn, <-chan *TrackerInfo) {
+	t.Helper()
+	observer.Configure(true, sessionID)
+	t.Cleanup(func() {
+		observer.Configure(false, "")
+		DefaultRequestNotify = nil
+	})
+
+	client, server := net.Pipe()
+	t.Cleanup(func() {
+		_ = client.Close()
+		_ = server.Close()
+	})
+	notifications := make(chan *TrackerInfo, 4)
+	DefaultRequestNotify = func(c Tracker) {
+		notifications <- c.Info()
+	}
+	tracker := NewTCPTracker(
+		&responseTestConn{ExtendedConn: N.NewExtendedConn(client)},
+		&Manager{},
+		&C.Metadata{},
+		nil,
+		0,
+		0,
+		false,
+		&C.ProtocolObservation{
+			SessionID: sessionID,
+			Kind:      "http1",
+			HTTP:      request,
+		},
+	)
+	return tracker, server, notifications
+}
+
+func TestTCPTrackerPublishesHTTPResponseObservation(t *testing.T) {
+	tracker, server, notifications := newResponseTracker(
+		t,
+		"capture-session",
+		&C.HTTPObservation{
+			Method:          "GET",
+			Target:          "/health",
+			Version:         "HTTP/1.1",
+			Host:            "service.example",
+			HeadersComplete: true,
+		},
+	)
+	initial := <-notifications
+	if initial.Observation == nil || initial.Observation.HTTPResponse != nil {
+		t.Fatalf("initial notification = %#v", initial.Observation)
+	}
+
+	payload := []byte("HTTP/1.1 201 private-reason\r\n" +
+		"Content-Type: text/plain\r\n" +
+		"Set-Cookie: private-cookie\r\n\r\n" +
+		"private-body")
+	writeDone := make(chan error, 1)
+	go func() {
+		_, err := server.Write(payload)
+		_ = server.Close()
+		writeDone <- err
+	}()
+
+	reader, counters := tracker.UnwrapReader()
+	if len(counters) != 1 {
+		t.Fatalf("read counters = %d", len(counters))
+	}
+	relayed, err := io.ReadAll(reader)
+	if err != nil {
+		t.Fatalf("read response: %v", err)
+	}
+	if err := <-writeDone; err != nil {
+		t.Fatalf("write response: %v", err)
+	}
+	if !bytes.Equal(relayed, payload) {
+		t.Fatal("response observation changed relayed bytes")
+	}
+
+	select {
+	case updated := <-notifications:
+		if updated.UUID != initial.UUID {
+			t.Fatalf("tracker id changed: %s -> %s", initial.UUID, updated.UUID)
+		}
+		response := updated.Observation.HTTPResponse
+		if response == nil || response.StatusCode != 201 {
+			t.Fatalf("updated observation = %#v", updated.Observation)
+		}
+		if len(response.HeaderNames) != 2 ||
+			response.HeaderNames[0] != "content-type" ||
+			response.HeaderNames[1] != "set-cookie" {
+			t.Fatalf("response header names = %#v", response.HeaderNames)
+		}
+		if !response.HeadersComplete || response.ObservedAfterMilliseconds < 0 {
+			t.Fatalf("response completion = %#v", response)
+		}
+		encoded, err := json.Marshal(updated)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, privateValue := range []string{"private-reason", "private-cookie", "private-body"} {
+			if bytes.Contains(encoded, []byte(privateValue)) {
+				t.Fatalf("tracker retained private response data: %s", encoded)
+			}
+		}
+	case <-time.After(time.Second):
+		t.Fatal("response update was not published")
+	}
+
+	if !tracker.httpResponseObservationDone() {
+		t.Fatal("response reader did not become replaceable")
+	}
+	if tracker.Info() != tracker.TrackerInfo {
+		t.Fatal("completed response tracker did not restore the zero-allocation Info path")
+	}
+	nextReader, _ := tracker.UnwrapReader()
+	if unwrapped := N.UnwrapReader(nextReader); unwrapped != tracker.Conn {
+		t.Fatalf("reader did not unwrap after observation: %T", unwrapped)
+	}
+}
+
+func TestTCPTrackerProductionCopyObservesAndCountsExactlyOnce(t *testing.T) {
+	tracker, server, notifications := newResponseTracker(
+		t,
+		"capture-session",
+		&C.HTTPObservation{
+			Method:          "GET",
+			Target:          "/copy",
+			Version:         "HTTP/1.1",
+			HeadersComplete: true,
+		},
+	)
+	<-notifications
+
+	payload := []byte("HTTP/1.1 200 OK\r\nContent-Length: 4\r\nX-Copy: private\r\n\r\nbody")
+	writeDone := make(chan error, 1)
+	go func() {
+		_, err := server.Write(payload)
+		_ = server.Close()
+		writeDone <- err
+	}()
+
+	var destination bytes.Buffer
+	copied, err := SBufio.Copy(&destination, tracker)
+	if err != nil {
+		t.Fatalf("production copy: %v", err)
+	}
+	if err := <-writeDone; err != nil {
+		t.Fatalf("write response: %v", err)
+	}
+	if copied != int64(len(payload)) || !bytes.Equal(destination.Bytes(), payload) {
+		t.Fatalf("copied=%d payload=%q", copied, destination.Bytes())
+	}
+	if tracker.DownloadTotal.Load() != int64(len(payload)) {
+		t.Fatalf("download total = %d, want %d", tracker.DownloadTotal.Load(), len(payload))
+	}
+	select {
+	case update := <-notifications:
+		response := update.Observation.HTTPResponse
+		if response == nil || response.StatusCode != 200 {
+			t.Fatalf("response update = %#v", update.Observation)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("production copy did not publish the response update")
+	}
+	select {
+	case duplicate := <-notifications:
+		t.Fatalf("production copy published a duplicate update: %#v", duplicate.Observation)
+	case <-time.After(20 * time.Millisecond):
+	}
+}
+
+type temporaryResponseReadError struct{}
+
+func (temporaryResponseReadError) Error() string   { return "temporary" }
+func (temporaryResponseReadError) Timeout() bool   { return true }
+func (temporaryResponseReadError) Temporary() bool { return true }
+
+func TestTerminalHTTPResponseReadError(t *testing.T) {
+	if terminalHTTPResponseReadError(nil) {
+		t.Fatal("nil read error was treated as terminal")
+	}
+	if terminalHTTPResponseReadError(temporaryResponseReadError{}) {
+		t.Fatal("temporary timeout was treated as terminal")
+	}
+	if !terminalHTTPResponseReadError(io.EOF) {
+		t.Fatal("EOF was not treated as terminal")
+	}
+}
+
+func TestTCPTrackerClosePublishesAPartialResponse(t *testing.T) {
+	tracker, server, notifications := newResponseTracker(
+		t,
+		"capture-session",
+		&C.HTTPObservation{
+			Method:          "GET",
+			Target:          "/close",
+			Version:         "HTTP/1.1",
+			HeadersComplete: true,
+		},
+	)
+	<-notifications
+
+	payload := []byte("HTTP/1.1 503 Service Unavailable\r\nRetry-After: private")
+	writeDone := make(chan error, 1)
+	go func() {
+		_, err := server.Write(payload)
+		writeDone <- err
+	}()
+	relayed := make([]byte, len(payload))
+	if _, err := io.ReadFull(tracker, relayed); err != nil {
+		t.Fatal(err)
+	}
+	if err := <-writeDone; err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(relayed, payload) {
+		t.Fatal("close observation changed response bytes")
+	}
+	select {
+	case update := <-notifications:
+		t.Fatalf("partial response published before close: %#v", update.Observation)
+	default:
+	}
+	if err := tracker.Close(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case update := <-notifications:
+		response := update.Observation.HTTPResponse
+		if response == nil || response.StatusCode != 503 || !response.Truncated || response.HeadersComplete {
+			t.Fatalf("close response = %#v", response)
+		}
+		if len(response.HeaderNames) != 1 || response.HeaderNames[0] != "retry-after" {
+			t.Fatalf("close header names = %#v", response.HeaderNames)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("close did not publish the partial response")
+	}
+}
+
+func TestTCPTrackerPublishesATruncatedResponseAtEOF(t *testing.T) {
+	tracker, server, notifications := newResponseTracker(
+		t,
+		"capture-session",
+		&C.HTTPObservation{
+			Method:          "GET",
+			Target:          "/partial",
+			Version:         "HTTP/1.1",
+			HeadersComplete: true,
+		},
+	)
+	<-notifications
+
+	payload := []byte("HTTP/1.1 502 Bad Gateway\r\nContent-Type: private\r\nX-Partial: private")
+	writeDone := make(chan error, 1)
+	go func() {
+		_, err := server.Write(payload)
+		_ = server.Close()
+		writeDone <- err
+	}()
+	reader, _ := tracker.UnwrapReader()
+	relayed, err := io.ReadAll(reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := <-writeDone; err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(relayed, payload) {
+		t.Fatal("EOF observation changed response bytes")
+	}
+	select {
+	case update := <-notifications:
+		response := update.Observation.HTTPResponse
+		if response == nil || response.StatusCode != 502 || !response.Truncated || response.HeadersComplete {
+			t.Fatalf("EOF response = %#v", response)
+		}
+		if len(response.HeaderNames) != 2 || response.HeaderNames[1] != "x-partial" {
+			t.Fatalf("EOF header names = %#v", response.HeaderNames)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("EOF response update was not published")
+	}
+}
+
+func TestTCPTrackerDropsResponseAfterCaptureStops(t *testing.T) {
+	tracker, server, notifications := newResponseTracker(
+		t,
+		"capture-session",
+		&C.HTTPObservation{
+			Method:          "GET",
+			Target:          "/",
+			Version:         "HTTP/1.1",
+			HeadersComplete: true,
+		},
+	)
+	<-notifications
+	observer.Configure(false, "")
+
+	payload := []byte("HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\n\r\nbody")
+	writeDone := make(chan error, 1)
+	go func() {
+		_, err := server.Write(payload)
+		_ = server.Close()
+		writeDone <- err
+	}()
+	reader, _ := tracker.UnwrapReader()
+	relayed, err := io.ReadAll(reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := <-writeDone; err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(relayed, payload) {
+		t.Fatal("disabled observer changed response bytes")
+	}
+	select {
+	case update := <-notifications:
+		t.Fatalf("unexpected response update: %#v", update.Observation)
+	case <-time.After(50 * time.Millisecond):
+	}
+	if tracker.Info().Observation.HTTPResponse != nil {
+		t.Fatal("response metadata survived after capture stopped")
+	}
+}
+
+func TestTCPTrackerDropsResponseAfterCaptureSessionChanges(t *testing.T) {
+	tracker, server, notifications := newResponseTracker(
+		t,
+		"capture-session-a",
+		&C.HTTPObservation{
+			Method:          "GET",
+			Target:          "/",
+			Version:         "HTTP/1.1",
+			HeadersComplete: true,
+		},
+	)
+	<-notifications
+	observer.Configure(true, "capture-session-b")
+
+	payload := []byte("HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n")
+	writeDone := make(chan error, 1)
+	go func() {
+		_, err := server.Write(payload)
+		_ = server.Close()
+		writeDone <- err
+	}()
+	reader, _ := tracker.UnwrapReader()
+	relayed, err := io.ReadAll(reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := <-writeDone; err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(relayed, payload) {
+		t.Fatal("session change altered response bytes")
+	}
+	select {
+	case update := <-notifications:
+		t.Fatalf("stale session published a response update: %#v", update.Observation)
+	case <-time.After(50 * time.Millisecond):
+	}
+	if tracker.Info().Observation.HTTPResponse != nil {
+		t.Fatal("response metadata crossed capture sessions")
+	}
