+func (tt *tcpTracker) observeHTTPResponse(data []byte, terminal bool) {
+	if tt.response == nil || tt.responseDone.Load() || (len(data) == 0 && !terminal) {
+		return
+	}
+
+	tt.responseMu.Lock()
+	if tt.responseDone.Load() {
+		tt.responseMu.Unlock()
+		return
+	}
+	tt.observationMu.RLock()
+	current := tt.TrackerInfo.Observation
+	tt.observationMu.RUnlock()
+	if current == nil || !observer.ActiveSession(current.SessionID) {
+		tt.responseDone.Store(true)
+		tt.responseMu.Unlock()
+		return
+	}
+	var response *C.HTTPResponseObservation
+	var done bool
+	if len(data) > 0 {
+		response, done = tt.response.Observe(data)
+	}
+	if !done && terminal {
+		response, done = tt.response.Finish()
+	}
+	if !done {
+		tt.responseMu.Unlock()
+		return
+	}
+	if response == nil {
+		tt.responseDone.Store(true)
+		tt.responseMu.Unlock()
+		return
+	}
