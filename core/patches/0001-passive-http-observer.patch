+func observePayload(t *testing.T, payload []byte, timeout time.Duration, limit int) (*N.BufferedConn, *C.ProtocolObservation) {
+	t.Helper()
+	client, peer := net.Pipe()
+	conn := N.NewBufferedConn(client)
+	writeDone := make(chan error, 1)
+	go func() {
+		_, err := peer.Write(payload)
+		_ = peer.Close()
+		writeDone <- err
+	}()
+	observation := observeTCP(conn, timeout, limit)
+	if err := <-writeDone; err != nil {
+		t.Fatalf("write payload: %v", err)
+	}
+	return conn, observation
+}
