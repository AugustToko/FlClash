diff --git a/component/observer/http_response.go b/component/observer/http_response.go
new file mode 100644
index 00000000..920fac34
--- /dev/null
+++ b/component/observer/http_response.go
@@ -0,0 +1,342 @@
+package observer
+
+import (
+	"strconv"
+	"strings"
+
+	C "github.com/metacubex/mihomo/constant"
+)
+
+const maxHTTPInformationalStatusCodes = 8
+
+type httpResponseLineKind uint8
+
+const (
+	httpResponseStatusLine httpResponseLineKind = iota
+	httpResponseHeaderLine
+)
+
+// HTTPResponseObserver incrementally extracts one bounded HTTP/1 response
+// header block. It stores only the status/version and header names: reason
+// phrases and header values are skipped while bytes continue to the client.
+type HTTPResponseObserver struct {
+	finished      bool
+	observedBytes int
+	lineKind      httpResponseLineKind
+	sawCR         bool
+
+	statusPrefix       [12]byte
+	statusPrefixLength int
+	statusDelimiter    bool
+	version            string
+	statusCode         int
+
+	headerLineStarted  bool
+	headerContinuation bool
+	headerHasColon     bool
+	headerName         [maxHTTPHeaderNameBytes]byte
+	headerNameLength   int
+	headerNameOverflow bool
+
+	headerNames          []string
+	headerNamesTruncated bool
+	headerFieldSeen      bool
+
+	informationalStatusCodes          []int
+	informationalStatusCodesTruncated bool
+}
+
+func NewHTTPResponseObserver() *HTTPResponseObserver {
+	return &HTTPResponseObserver{}
+}
+
+// Observe consumes server bytes without retaining payload data. The returned
+// boolean becomes true once parsing has completed, become invalid, or reached
+// its bound. A nil result with done=true means the stream was not HTTP/1.
+func (o *HTTPResponseObserver) Observe(data []byte) (result *C.HTTPResponseObservation, done bool) {
+	if o == nil || o.finished {
+		return nil, true
+	}
+	for _, value := range data {
+		if o.observedBytes >= maxObservationBytes {
+			return o.finishTruncated()
+		}
+		o.observedBytes++
+
+		if o.sawCR {
+			if value != '\n' {
+				return o.finishInvalid()
+			}
+			o.sawCR = false
+			if result, done = o.finishLine(); done {
+				o.finished = true
+				return result, true
+			}
+			continue
+		}
+		switch value {
+		case '\r':
+			o.sawCR = true
+			continue
+		case '\n':
+			return o.finishInvalid()
+		}
+
+		var valid bool
+		switch o.lineKind {
+		case httpResponseStatusLine:
+			valid = o.consumeStatusByte(value)
+		case httpResponseHeaderLine:
+			valid = o.consumeHeaderByte(value)
+		default:
+			valid = false
+		}
+		if !valid {
+			return o.finishInvalid()
+		}
+	}
+	if o.observedBytes >= maxObservationBytes {
+		return o.finishTruncated()
+	}
+	return nil, false
+}
+
+// Finish closes an observation when the underlying connection terminates.
+// A parsed status line is still useful even when the peer closes before the
+// terminating empty header line; the result is explicitly marked truncated.
+func (o *HTTPResponseObserver) Finish() (*C.HTTPResponseObservation, bool) {
+	if o == nil || o.finished {
+		return nil, true
+	}
+	o.finished = true
+	if o.statusCode == 0 && len(o.informationalStatusCodes) == 0 {
+		return nil, true
+	}
+	return o.snapshot(false, true), true
+}
+
+func (o *HTTPResponseObserver) consumeStatusByte(value byte) bool {
+	if o.statusPrefixLength < len(o.statusPrefix) {
+		position := o.statusPrefixLength
+		switch {
+		case position < len("HTTP/1."):
+			if value != "HTTP/1."[position] {
+				return false
+			}
+		case position == 7:
+			if value != '0' && value != '1' {
+				return false
+			}
+		case position == 8:
+			if value != ' ' {
+				return false
+			}
+		default:
+			if value < '0' || value > '9' {
+				return false
+			}
+		}
+		o.statusPrefix[position] = value
+		o.statusPrefixLength++
+		return true
+	}
+
+	if !o.statusDelimiter {
+		if value != ' ' && value != '\t' {
+			return false
+		}
+		o.statusDelimiter = true
+		return true
+	}
+	return validHTTPFieldValueByte(value)
+}
+
+func (o *HTTPResponseObserver) consumeHeaderByte(value byte) bool {
+	if !o.headerLineStarted {
+		o.headerLineStarted = true
+		if value == ' ' || value == '\t' {
+			if !o.headerFieldSeen {
+				return false
+			}
+			o.headerContinuation = true
+			return true
+		}
+	}
+	if o.headerContinuation || o.headerHasColon {
+		return validHTTPFieldValueByte(value)
+	}
+	if value == ':' {
+		if o.headerNameLength == 0 && !o.headerNameOverflow {
+			return false
+		}
+		o.headerHasColon = true
+		o.headerFieldSeen = true
+		if o.retainsCurrentHeaderNames() {
+			o.recordHeaderName()
+		}
+		return true
+	}
+	if !validHeaderNameByte(value) {
+		return false
+	}
+	if o.headerNameLength < len(o.headerName) {
+		o.headerName[o.headerNameLength] = value
+		o.headerNameLength++
+	} else {
+		o.headerNameOverflow = true
+		o.headerNamesTruncated = true
+	}
+	return true
+}
+
+func (o *HTTPResponseObserver) finishLine() (*C.HTTPResponseObservation, bool) {
+	switch o.lineKind {
+	case httpResponseStatusLine:
+		if !o.parseStatusPrefix() {
+			return o.finishInvalid()
+		}
+		o.lineKind = httpResponseHeaderLine
+		o.resetHeaderLine()
+		return nil, false
+	case httpResponseHeaderLine:
+		if !o.headerLineStarted {
+			return o.finishHeaderBlock()
+		}
+		if !o.headerContinuation && !o.headerHasColon {
+			return o.finishInvalid()
+		}
+		o.resetHeaderLine()
+		return nil, false
+	default:
+		return o.finishInvalid()
+	}
+}
+
+func (o *HTTPResponseObserver) parseStatusPrefix() bool {
+	if o.statusPrefixLength != len(o.statusPrefix) {
+		return false
+	}
+	o.version = string(o.statusPrefix[:8])
+	statusCode, err := strconv.Atoi(string(o.statusPrefix[9:12]))
+	if err != nil || statusCode < 100 || statusCode > 599 {
+		return false
+	}
+	o.statusCode = statusCode
+	return true
+}
+
+func (o *HTTPResponseObserver) finishHeaderBlock() (*C.HTTPResponseObservation, bool) {
+	if o.statusCode >= 100 && o.statusCode < 200 && o.statusCode != 101 {
+		if len(o.informationalStatusCodes) < maxHTTPInformationalStatusCodes {
+			o.informationalStatusCodes = append(o.informationalStatusCodes, o.statusCode)
+		} else {
+			o.informationalStatusCodesTruncated = true
+		}
+		o.resetForNextResponse()
+		return nil, false
+	}
+	return o.snapshot(true, o.metadataTruncated()), true
+}
+
+func (o *HTTPResponseObserver) resetForNextResponse() {
+	o.lineKind = httpResponseStatusLine
+	o.statusPrefixLength = 0
+	o.statusDelimiter = false
+	o.version = ""
+	o.statusCode = 0
+	o.headerNames = nil
+	o.headerNamesTruncated = false
+	o.headerFieldSeen = false
+	o.resetHeaderLine()
+}
+
+func (o *HTTPResponseObserver) resetHeaderLine() {
+	o.headerLineStarted = false
+	o.headerContinuation = false
+	o.headerHasColon = false
+	o.headerNameLength = 0
+	o.headerNameOverflow = false
+}
+
+func (o *HTTPResponseObserver) retainsCurrentHeaderNames() bool {
+	return o.statusCode == 101 || o.statusCode >= 200
+}
+
+func (o *HTTPResponseObserver) recordHeaderName() {
+	name := strings.ToLower(string(o.headerName[:o.headerNameLength]))
+	for _, existing := range o.headerNames {
+		if existing == name {
+			return
+		}
+	}
+	if len(o.headerNames) < maxHTTPHeaderNames {
+		o.headerNames = append(o.headerNames, name)
+	} else {
+		o.headerNamesTruncated = true
+	}
+}
+
+func (o *HTTPResponseObserver) finishTruncated() (*C.HTTPResponseObservation, bool) {
+	o.finished = true
+	if o.statusCode == 0 && len(o.informationalStatusCodes) == 0 {
+		return nil, true
+	}
+	return o.snapshot(false, true), true
+}
+
+func (o *HTTPResponseObserver) finishInvalid() (*C.HTTPResponseObservation, bool) {
+	o.finished = true
+	return nil, true
+}
+
+func (o *HTTPResponseObserver) snapshot(headersComplete bool, truncated bool) *C.HTTPResponseObservation {
+	statusCode := o.statusCode
+	version := o.version
+	headerNames := o.headerNames
+	informationalStatusCodes := append([]int(nil), o.informationalStatusCodes...)
+	informationalStatusCodesTruncated := o.informationalStatusCodesTruncated
+	if statusCode >= 100 && statusCode < 200 && statusCode != 101 {
+		if len(informationalStatusCodes) < maxHTTPInformationalStatusCodes {
+			informationalStatusCodes = append(informationalStatusCodes, statusCode)
+		} else {
+			informationalStatusCodesTruncated = true
+		}
+		statusCode = 0
+		version = ""
+		headerNames = nil
+	}
+	return &C.HTTPResponseObservation{
+		Version:                           version,
+		StatusCode:                        statusCode,
+		InformationalStatusCodes:          informationalStatusCodes,
+		HeaderNames:                       append([]string(nil), headerNames...),
+		HeadersComplete:                   headersComplete,
+		ObservedBytes:                     o.observedBytes,
+		Truncated:                         truncated,
+		HeaderNamesTruncated:              o.headerNamesTruncated,
+		InformationalStatusCodesTruncated: informationalStatusCodesTruncated,
+	}
+}
+
+func (o *HTTPResponseObserver) metadataTruncated() bool {
+	return o.headerNamesTruncated || o.informationalStatusCodesTruncated
+}
+
+func validHTTPFieldValueByte(value byte) bool {
+	// Accept visible ASCII plus RFC 7230 obs-text while discarding all values.
+	// Controls other than HTAB are invalid and end observation fail-closed.
+	return value == '\t' || (value >= 0x20 && value != 0x7f)
+}
+
+func validHeaderNameByte(value byte) bool {
+	switch {
+	case value >= 'a' && value <= 'z':
+		return true
+	case value >= 'A' && value <= 'Z':
+		return true
+	case value >= '0' && value <= '9':
+		return true
+	default:
+		return strings.ContainsRune("!#$%&'*+-.^_`|~", rune(value))
+	}
+}
diff --git a/component/observer/http_response_test.go b/component/observer/http_response_test.go
new file mode 100644
index 00000000..fc5d12aa
--- /dev/null
+++ b/component/observer/http_response_test.go
@@ -0,0 +1,326 @@
+package observer
+
+import (
+	"bytes"
+	"encoding/json"
+	"slices"
+	"strings"
+	"testing"
+)
+
+func TestHTTPResponseObserverCompleteResponse(t *testing.T) {
+	header := []byte("HTTP/1.1 200 private-reason\r\n" +
+		"Content-Type: text/plain\r\n" +
+		"Set-Cookie: session=private-cookie\r\n" +
+		"X-Trace: private-trace\r\n\r\n")
+	payload := append(append([]byte(nil), header...), []byte("private-response-body")...)
+	observer := NewHTTPResponseObserver()
+
+	response, done := observer.Observe(payload[:11])
+	if response != nil || done {
+		t.Fatalf("partial response = %#v/%v", response, done)
+	}
+	response, done = observer.Observe(payload[11:57])
+	if response != nil || done {
+		t.Fatalf("partial response = %#v/%v", response, done)
+	}
+	response, done = observer.Observe(payload[57:])
+	if !done || response == nil {
+		t.Fatalf("final response = %#v/%v", response, done)
+	}
+	if response.Version != "HTTP/1.1" || response.StatusCode != 200 {
+		t.Fatalf("identity = %#v", response)
+	}
+	if strings.Join(response.HeaderNames, ",") != "content-type,set-cookie,x-trace" {
+		t.Fatalf("header names = %#v", response.HeaderNames)
+	}
+	if !response.HeadersComplete || response.Truncated {
+		t.Fatalf("completion = %#v", response)
+	}
+	if response.ObservedBytes != len(header) {
+		t.Fatalf("observed bytes = %d, want %d", response.ObservedBytes, len(header))
+	}
+
+	encoded, err := json.Marshal(response)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, secret := range []string{
+		"private-reason",
+		"private-cookie",
+		"private-trace",
+		"private-response-body",
+	} {
+		if bytes.Contains(encoded, []byte(secret)) {
+			t.Fatalf("serialized response retained %q: %s", secret, encoded)
+		}
+	}
+}
+
+func TestHTTPResponseObserverHandlesInformationalResponses(t *testing.T) {
+	payload := []byte("HTTP/1.1 100 Continue\r\n" +
+		"X-Interim: private-a\r\n\r\n" +
+		"HTTP/1.1 103 Early Hints\r\n" +
+		"Link: private-b\r\n\r\n" +
+		"HTTP/1.1 204 No Content\r\n" +
+		"Date: private-c\r\n" +
+		"X-Final: private-d\r\n\r\n")
+	observer := NewHTTPResponseObserver()
+	for _, value := range payload {
+		response, done := observer.Observe([]byte{value})
+		if !done {
+			continue
+		}
+		if response == nil {
+			t.Fatal("informational chain produced no final response")
+		}
+		if response.StatusCode != 204 || response.Version != "HTTP/1.1" {
+			t.Fatalf("final response = %#v", response)
+		}
+		if !slices.Equal(response.InformationalStatusCodes, []int{100, 103}) {
+			t.Fatalf("informational statuses = %#v", response.InformationalStatusCodes)
+		}
+		if strings.Join(response.HeaderNames, ",") != "date,x-final" {
+			t.Fatalf("final header names = %#v", response.HeaderNames)
+		}
+		return
+	}
+	t.Fatal("observer did not complete")
+}
+
+func TestHTTPResponseObserverTreatsSwitchingProtocolsAsFinal(t *testing.T) {
+	observer := NewHTTPResponseObserver()
+	response, done := observer.Observe([]byte(
+		"HTTP/1.1 101 Switching Protocols\r\n" +
+			"Upgrade: websocket\r\n" +
+			"Connection: Upgrade\r\n\r\n" +
+			"opaque-protocol-data",
+	))
+	if !done || response == nil {
+		t.Fatalf("response = %#v/%v", response, done)
+	}
+	if response.StatusCode != 101 ||
+		strings.Join(response.HeaderNames, ",") != "upgrade,connection" {
+		t.Fatalf("switching protocols = %#v", response)
+	}
+}
+
+func TestHTTPResponseObserverAllowsContinuationAfterAHeaderField(t *testing.T) {
+	observer := NewHTTPResponseObserver()
+	result, done := observer.Observe([]byte(
+		"HTTP/1.1 200 OK\r\n" +
+			"X-Note: one\r\n" +
+			"\tcontinued\r\n\r\n",
+	))
+	if !done || result == nil || !result.HeadersComplete {
+		t.Fatalf("folded response = %#v done=%v", result, done)
+	}
+	if len(result.HeaderNames) != 1 || result.HeaderNames[0] != "x-note" {
+		t.Fatalf("header names = %#v", result.HeaderNames)
+	}
+}
+
+func TestHTTPResponseObserverAcceptsObsTextWithoutRetainingValues(t *testing.T) {
+	observer := NewHTTPResponseObserver()
+	payload := append([]byte("HTTP/1.1 200 OK\r\nX-Legacy: "), 0x80, 0xff)
+	payload = append(payload, []byte("\r\n\r\n")...)
+	response, done := observer.Observe(payload)
+	if !done || response == nil || response.StatusCode != 200 {
+		t.Fatalf("obs-text response = %#v/%v", response, done)
+	}
+	encoded, err := json.Marshal(response)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if bytes.Contains(encoded, []byte{0x80}) || bytes.Contains(encoded, []byte{0xff}) {
+		t.Fatalf("obs-text value leaked: %q", encoded)
+	}
+}
+
+func TestHTTPResponseObserverRejectsNonHTTPAndMalformedStreams(t *testing.T) {
+	for _, payload := range [][]byte{
+		[]byte("SSH-2.0-OpenSSH_9.0\r\n"),
+		[]byte("HTTP/2 200 OK\r\n\r\n"),
+		[]byte("HTTP/1.1 099 Invalid\r\n\r\n"),
+		[]byte("HTTP/1.1 200 OK\nHeader: value\n\n"),
+		[]byte("HTTP/1.1 200 OK\r\nBad Header: value\r\n\r\n"),
+		[]byte("HTTP/1.1 200 OK\r\n private-fold\r\n\r\n"),
+		[]byte("HTTP/1.1 200 OK\x7f\r\n\r\n"),
+		[]byte("HTTP/1.1 200 OK\r\nX-Test: value\x7f\r\n\r\n"),
+	} {
+		observer := NewHTTPResponseObserver()
+		response, done := observer.Observe(payload)
+		if !done || response != nil {
+			t.Fatalf("payload %q produced %#v/%v", payload, response, done)
+		}
+	}
+}
+
+func TestHTTPResponseObserverFinishPublishesATruncatedParsedResponse(t *testing.T) {
+	observer := NewHTTPResponseObserver()
+	response, done := observer.Observe([]byte(
+		"HTTP/1.1 206 Partial Content\r\n" +
+			"Content-Type: private-value\r\n" +
+			"X-Incomplete: private-value",
+	))
+	if response != nil || done {
+		t.Fatalf("partial response = %#v/%v", response, done)
+	}
+	response, done = observer.Finish()
+	if !done || response == nil {
+		t.Fatalf("finished response = %#v/%v", response, done)
+	}
+	if response.StatusCode != 206 || response.HeadersComplete || !response.Truncated {
+		t.Fatalf("finished metadata = %#v", response)
+	}
+	if strings.Join(response.HeaderNames, ",") != "content-type,x-incomplete" {
+		t.Fatalf("header names = %#v", response.HeaderNames)
+	}
+	encoded, err := json.Marshal(response)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if bytes.Contains(encoded, []byte("private-value")) {
+		t.Fatalf("finished response retained a value: %s", encoded)
+	}
+}
+
+func TestHTTPResponseObserverFinishPreservesAPartialInformationalStatus(t *testing.T) {
+	observer := NewHTTPResponseObserver()
+	response, done := observer.Observe([]byte(
+		"HTTP/1.1 103 Early Hints\r\n" +
+			"Link: private-value",
+	))
+	if response != nil || done {
+		t.Fatalf("partial informational response = %#v/%v", response, done)
+	}
+	response, done = observer.Finish()
+	if !done || response == nil {
+		t.Fatalf("finished informational response = %#v/%v", response, done)
+	}
+	if response.StatusCode != 0 || len(response.InformationalStatusCodes) != 1 ||
+		response.InformationalStatusCodes[0] != 103 || !response.Truncated {
+		t.Fatalf("informational metadata = %#v", response)
+	}
+	encoded, err := json.Marshal(response)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if bytes.Contains(encoded, []byte("private-value")) {
+		t.Fatalf("informational response retained a value: %s", encoded)
+	}
+}
+
+func TestHTTPResponseObserverFinishDropsAnUnparsedStatusLine(t *testing.T) {
+	observer := NewHTTPResponseObserver()
+	response, done := observer.Observe([]byte("HTTP/1.1 20"))
+	if response != nil || done {
+		t.Fatalf("partial status = %#v/%v", response, done)
+	}
+	response, done = observer.Finish()
+	if !done || response != nil {
+		t.Fatalf("unfinished status produced %#v/%v", response, done)
+	}
+}
+
+func TestHTTPResponseObserverBoundsIncompleteHeaders(t *testing.T) {
+	observer := NewHTTPResponseObserver()
+	prefix := []byte("HTTP/1.1 200 OK\r\nX-Large: ")
+	response, done := observer.Observe(prefix)
+	if response != nil || done {
+		t.Fatalf("prefix = %#v/%v", response, done)
+	}
+	response, done = observer.Observe(bytes.Repeat([]byte{'a'}, maxObservationBytes))
+	if !done || response == nil {
+		t.Fatalf("bounded response = %#v/%v", response, done)
+	}
+	if response.StatusCode != 200 || response.HeadersComplete || !response.Truncated {
+		t.Fatalf("bounded metadata = %#v", response)
+	}
+	if response.ObservedBytes != maxObservationBytes {
+		t.Fatalf("observed bytes = %d", response.ObservedBytes)
+	}
+	encoded, _ := json.Marshal(response)
+	if bytes.Contains(encoded, []byte(strings.Repeat("a", 16))) {
+		t.Fatalf("header value retained: %s", encoded)
+	}
+}
+
+func TestHTTPResponseObserverBoundsHeaderNamesAndInformationalCodes(t *testing.T) {
+	longName := "X-" + strings.Repeat("A", maxHTTPHeaderNameBytes+64)
+	var payload strings.Builder
+	for index := 0; index < maxHTTPInformationalStatusCodes+3; index++ {
+		payload.WriteString("HTTP/1.1 100 Continue\r\n\r\n")
+	}
+	payload.WriteString("HTTP/1.1 200 OK\r\n")
+	payload.WriteString(longName)
+	payload.WriteString(": private-value\r\n\r\n")
+
+	observer := NewHTTPResponseObserver()
+	response, done := observer.Observe([]byte(payload.String()))
+	if !done || response == nil {
+		t.Fatalf("response = %#v/%v", response, done)
+	}
+	if !response.Truncated ||
+		!response.HeaderNamesTruncated ||
+		!response.InformationalStatusCodesTruncated {
+		t.Fatalf("truncation flags = %#v", response)
+	}
+	if len(response.HeaderNames) != 1 ||
+		len(response.HeaderNames[0]) > maxHTTPHeaderNameBytes {
+		t.Fatalf("bounded header names = %#v", response.HeaderNames)
+	}
+	if len(response.InformationalStatusCodes) != maxHTTPInformationalStatusCodes {
+		t.Fatalf("bounded informational statuses = %#v", response.InformationalStatusCodes)
+	}
+}
+
+func TestHTTPResponseObserverDeduplicatesHeaderNames(t *testing.T) {
+	observer := NewHTTPResponseObserver()
+	response, done := observer.Observe([]byte(
+		"HTTP/1.0 304 Not Modified\r\n" +
+			"Cache-Control: private-a\r\n" +
+			"cache-control: private-b\r\n" +
+			"ETag: private-c\r\n\r\n",
+	))
+	if !done || response == nil {
+		t.Fatalf("response = %#v/%v", response, done)
+	}
+	if response.Version != "HTTP/1.0" ||
+		!slices.Equal(response.HeaderNames, []string{"cache-control", "etag"}) {
+		t.Fatalf("deduplicated response = %#v", response)
+	}
+}
+
+func FuzzHTTPResponseObserverNeverPanics(f *testing.F) {
+	for _, seed := range [][]byte{
+		[]byte("HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\n\r\nbody"),
+		[]byte("HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 204 No Content\r\n\r\n"),
+		[]byte("SSH-2.0-OpenSSH_9.0\r\n"),
+		bytes.Repeat([]byte{'A'}, maxObservationBytes+1),
+	} {
+		f.Add(seed)
+	}
+	f.Fuzz(func(t *testing.T, input []byte) {
+		if len(input) > maxObservationBytes*2 {
+			input = input[:maxObservationBytes*2]
+		}
+		observer := NewHTTPResponseObserver()
+		for offset := 0; offset < len(input); {
+			next := offset + 17
+			if next > len(input) {
+				next = len(input)
+			}
+			result, done := observer.Observe(input[offset:next])
+			if result != nil {
+				if _, err := json.Marshal(result); err != nil {
+					t.Fatal(err)
+				}
+			}
+			offset = next
+			if done {
+				return
+			}
+		}
+	})
+}
